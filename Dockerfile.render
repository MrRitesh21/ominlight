# ── OmniRoute Render Cloud Runner (Ultra-Fast <30s Deploy) ───────────────
# Uses official pre-compiled OmniRoute production standalone image as base:
# - Zero compilation on Render: eliminates builder OOM crashes entirely
# - Ultra-fast deployment: deploys in ~20-30 seconds instead of 6+ minutes
# - 512MB RAM optimization: clamps V8 heap to 350MB at runtime
# - Render PostgreSQL persistence: restores SQLite on boot, snapshots every 2m
# - Keep-alive worker: pings health endpoint every 9m to prevent idle sleep
# - Full Web Dashboard UI & all 375 AI providers included

FROM diegosouzapw/omniroute:latest

USER root

# Install postgres client for Render PostgreSQL backup/restore sync
RUN npm install --no-audit --no-fund --legacy-peer-deps pg \
  && chown -R node:node /app/node_modules/pg

ENV NODE_ENV=production
ENV PORT=10000
ENV HOSTNAME=0.0.0.0
ENV HOST=0.0.0.0

# 512MB RAM ceiling optimization:
ENV OMNIROUTE_MEMORY_MB=350
ENV NODE_OPTIONS="--max-old-space-size=350"

# Render default parameters
ENV DATA_DIR=/app/data
ENV KEEP_ALIVE=true
ENV REQUIRE_API_KEY=false
ENV OMNIROUTE_MIGRATIONS_DIR=/app/migrations

RUN mkdir -p /app/data && chown -R node:node /app /app/data

# Copy Render scripts
COPY --chown=node:node scripts/render/ /app/scripts/render/

EXPOSE 10000

USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "healthcheck.mjs"]

CMD ["node", "scripts/render/run-render.mjs"]
